# Copy this file to `.env` and adjust the values. The `.env` file is read at
# build/run time via `--dart-define-from-file=.env` and the values are compiled
# into the binary. The file itself is gitignored.

# OpenTelemetry
# Minimum severity for exported log records
# (trace/debug/info|information/warn|warning/error/fatal/none; '' = all)
OTEL_LOG_LEVEL=information
# OTLP/HTTP endpoint of the traces/logs/metrics collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Trace sampling strategy
# (always_on/always_off/traceidratio/parentbased_traceidratio)
OTEL_TRACES_SAMPLER=always_on
# Sampling ratio for `traceidratio` and `parentbased_traceidratio` (0.0-1.0)
OTEL_TRACES_SAMPLER_RATIO=1.0
# Capture `print()` calls as OTel logs
OTEL_LOG_PRINT=true

# API
# Base URL of the Serv-Oeste backend (must end with /)
API_URL=http://localhost:8080/api/